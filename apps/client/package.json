{
  "name": "@kodakiko/client",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "build:workers": "node scripts/build-web-workers.ts",
    "start:web": "pnpm build:workers && expo start --web --port 8081",
    "build:web": "pnpm build:workers && expo export --platform web",
    "prebuild:android": "expo prebuild --platform android --clean",
    "start:metro-ui": "expo start --port 8081",
    "run:android": "expo run:android"
  },
  "dependencies": {
    "@expo/log-box": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@kodakiko/contract": "workspace:*",
    "@kodakiko/core": "workspace:*",
    "@shopify/flash-list": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-file-system": "catalog:",
    "expo-image": "catalog:",
    "expo-linking": "catalog:",
    "expo-local-authentication": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sqlite": "catalog:",
    "idb": "catalog:",
    "libsodium-wrappers-sumo": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-libsodium": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-web": "catalog:",
    "react-native-worklets": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:"
  }
