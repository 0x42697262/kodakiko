{
	email {$ACME_EMAIL}
}

(tls_dns) {
	tls {
		dns cloudflare {env.DNS_API_TOKEN}
	}
}

kodakiko.{$DOMAIN} {
	import tls_dns
	encode zstd gzip
	handle /api/* {
		request_body {
			max_size 2MiB
		}
		reverse_proxy api:8080
	}
	handle /health/* {
		reverse_proxy api:8080
	}
	handle /s/* {
		import snippets/link-viewer-headers.caddy
		header Cache-Control "no-cache"
		root * /srv/web
		rewrite * /viewer.html
		file_server
	}
	@viewerAssets path /viewer.js /styles.css /media-sw.js
	handle @viewerAssets {
		import snippets/link-viewer-headers.caddy
		header Cache-Control "no-cache"
		root * /srv/web
		file_server
	}
	handle {
		import snippets/security-headers.caddy
		header Cache-Control "no-cache"
		root * /srv/web
		rewrite * /index.html
		file_server
	}
}

s3.kodakiko.{$DOMAIN} {
	import tls_dns
	request_body {
		max_size {$S3_MAX_BODY}
	}
	reverse_proxy garage:3900 {
		header_up Host {host}
	}
}
