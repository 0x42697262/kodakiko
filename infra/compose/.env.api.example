# Kodakiko server settings (spec 21 §3). Copy to .env.api next to docker-compose.yml.
# DATABASE_URL and SERVER_VERSION are set by docker-compose.yml and override the values here.
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: printed once by the garage-setup service (docs/operations.md §3).
ACCOUNT_DELETION_GRACE_DAYS=7
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_URL=set-by-compose
DEFAULT_QUOTA_BYTES=107374182400
DOWNLOAD_URL_TTL_SECONDS=900
FAILED_SIGN_IN_WINDOW_MINUTES=60
FAKE_PARAMS_SECRET=
FLAG_PUBLIC_LINKS=false
FLAG_SHARING=false
HOST=0.0.0.0
INVITE_DEFAULT_EXPIRY_DAYS=7
JOB_ABORT_STALE_UPLOADS_INTERVAL_MINUTES=60
JOB_COLLECT_OBJECTS_INTERVAL_MINUTES=10
JOB_ERASE_ACCOUNTS_INTERVAL_MINUTES=60
JOB_EXPIRE_PUBLIC_LINKS_INTERVAL_MINUTES=60
JOB_EXPIRE_SESSIONS_INTERVAL_MINUTES=1440
JOB_PRUNE_TOMBSTONES_INTERVAL_MINUTES=1440
JOB_PURGE_TRASH_INTERVAL_MINUTES=60
JOB_RECONCILE_USAGE_INTERVAL_MINUTES=1440
JOBS_ENABLED=true
LINK_VIEW_TOKEN_MINUTES=60
LOG_LEVEL=info
MAX_COLLECTION_METADATA_BYTES=4096
MAX_DIFF_PAGE_SIZE=500
MAX_ENTRIES_PER_LINK=100
MAX_ENTRY_METADATA_BYTES=524288
MAX_FAILED_SIGN_INS=10
MAX_MEDIA_PER_ENTRY=20
MAX_PRESIGNS_PER_HOUR=1000
MAX_PUBLIC_LINKS_PER_USER=100
MAX_RECIPIENTS_PER_COLLECTION=50
MAX_SHARED_COLLECTIONS_PER_USER=200
MAX_UPLOAD_BYTES=3758096384
MULTIPART_PART_BYTES=8388608
OBJECT_GRACE_DAYS=7
PENDING_UPLOAD_HOURS=48
PORT=8080
PUBLIC_BASE_URL=https://kodakiko.example.com
PUBLIC_LINK_PROXY=false
RATE_LIMITS_ENABLED=true
REQUIRE_HTTPS=true
S3_ACCESS_KEY_ID=
S3_BUCKET=kodakiko
S3_ENDPOINT=http://garage:3900
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=https://s3.kodakiko.example.com
S3_REGION=garage
S3_SECRET_ACCESS_KEY=
SERVER_VERSION=set-by-compose
SESSION_IDLE_DAYS=30
SHUTDOWN_TIMEOUT_MS=15000
SIGNUP_MODE=invite
SINGLE_PART_MAX_BYTES=8388608
STORAGE_PROVIDER=garage
STORAGE_REQUEST_TIMEOUT_MS=15000
TOMBSTONE_RETENTION_DAYS=90
TRASH_DAYS=30
TRUSTED_PROXIES=loopback,uniquelocal
UPLOAD_URL_TTL_SECONDS=86400
