# Kodakiko compose settings (spec 21 §3). Copy to .env next to docker-compose.yml.
# Server settings live in .env.api (copy .env.api.example); the API container never sees this file.
# Secrets are empty on purpose; docs/operations.md §3 has the commands that generate them.
# Compose only
REGISTRY=ghcr.io/OWNER
KODAKIKO_VERSION=
BIND_IP=
DOMAIN=example.com
ACME_EMAIL=
DNS_API_TOKEN=
S3_MAX_BODY=9MiB
POSTGRES_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_DATA_PATH=garage-data
BACKUP_DIR=/srv/kodakiko-backup
RCLONE_REMOTE=
