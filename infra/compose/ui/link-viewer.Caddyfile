{
  auto_https off
}

http://:9580 {
  handle /api/* {
    reverse_proxy host.docker.internal:9582
  }
  handle /health/* {
    reverse_proxy host.docker.internal:9582
  }
  handle /s/* {
    import snippets/link-viewer-headers.caddy
    header Cache-Control "no-cache"
    root * /srv/web
    rewrite * /viewer.html
    file_server
  }
  @viewerAssets path /viewer.js /styles.css /media-sw.js
  handle @viewerAssets {
    import snippets/link-viewer-headers.caddy
    header Cache-Control "no-cache"
    root * /srv/web
    file_server
  }
  handle {
    import snippets/security-headers.caddy
    header Cache-Control "no-cache"
    root * /srv/web
    rewrite * /index.html
    file_server
  }
}
