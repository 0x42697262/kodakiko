{
  "name": "kodakiko",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:generated",
    "check:generated": "node tests/fixtures/ui-strings/emit-android.ts --check && node apps/android/tools/licenses/emit-licenses.ts --check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "test": "pnpm -r --filter '!@kodakiko/e2e' test && pnpm test:scripts",
    "test:e2e": "pnpm --filter @kodakiko/e2e test",
    "format": "prettier --write .",
    "ui:web": "pnpm --filter @kodakiko/ui-tests test:web",
    "ui:link-viewer": "pnpm --filter @kodakiko/ui-tests test:link-viewer",
    "ui:android": "pnpm --filter @kodakiko/ui-tests test:android",
    "test:scripts": "vitest run --config vitest.scripts.config.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
