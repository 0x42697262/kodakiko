{
  "name": "kodakiko",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "ui:web": "pnpm --filter @kodakiko/ui-tests test:web",
    "ui:android": "pnpm --filter @kodakiko/ui-tests test:android"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
