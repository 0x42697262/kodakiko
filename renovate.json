{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "automerge": false,
  "groupName": null,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": null,
      "automerge": false
    },
    {
      "matchPackageNames": ["libsodium*", "com.goterl:lazysodium*"],
      "labels": ["needs-crypto-review"],
      "automerge": false
    }
  ]
}
